{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "FreeGameRadar": {
    "DatabasePath": "App_Data/freegameradar.db",
    "RefreshIntervalMinutes": 240,
    "InitialRefreshOnStartup": true,
    "HttpTimeoutSeconds": 25,
    "Sources": {
      "GamerPower": {
        "Enabled": true,
        "Url": "https://www.gamerpower.com/api/giveaways?sort-by=date"
      },
      "CheapShark": {
        "Enabled": true,
        "DealsUrl": "https://www.cheapshark.com/api/1.0/deals?upperPrice=25&sortBy=Deal%20Rating&pageSize=60",
        "StoresUrl": "https://www.cheapshark.com/api/1.0/stores"
      }
    }
  }
}
